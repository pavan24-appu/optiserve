services:
  db:
    image: postgres:16
    environment: { POSTGRES_PASSWORD: optiserve, POSTGRES_DB: optiserve }
    volumes: [pgdata:/var/lib/postgresql/data]
  api:
    build: ./backend
    environment: { DATABASE_URL: postgresql://postgres:optiserve@db:5432/optiserve }
    ports: ["8000:8000"]
    depends_on: [db]
volumes: { pgdata: {} }